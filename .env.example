# VehicleShield Environment Configuration

PROJECT_NAME=VehicleShield
ENVIRONMENT=production

# Security
SECRET_KEY=vehicleshield-production-secure-random-key-change-this
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
DATABASE_URL=sqlite:///./vehicleshield.db
# For PostgreSQL production:
# DATABASE_URL=postgresql://vehicleshield:secure_db_pass_2026@localhost:5432/vehicleshield_db

# OCR & AI Configuration
MIN_OCR_CONFIDENCE=0.35
MIN_PLATE_DETECTION_CONFIDENCE=0.40

# PostgreSQL Container Variables
POSTGRES_USER=vehicleshield
POSTGRES_PASSWORD=secure_db_pass_2026
POSTGRES_DB=vehicleshield_db
